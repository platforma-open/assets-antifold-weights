{
  "name": "@platforma-open/milaboratories.antifold-weights-assets.antifold",
  "version": "1.0.0",
  "license": "MIT",
  "description": "AntiFold inverse-folding model checkpoint (opig.stats.ox.ac.uk, license unresolved — see LICENSE-NOTES.md)",
  "scripts": {
    "cleanup": "rm -rf ./pkg-*.tgz ./pkg-*.zip && rm -rf ./build/ && rm -rf ./dist/ && rm -rf ./indexed_model/",
    "build": "../scripts/download-weights.sh ./modelInfo.json",
    "postbuild": "pl-pkg build && ([ -z \"${CI}\" ] || pl-pkg publish)"
  },
  "block-software": {
    "entrypoints": {
      "main": {
        "asset": {
          "type": "asset",
          "registry": "platforma-open",
          "root": "./indexed_model/antifold"
        }
      }
    }
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "@platforma-sdk/package-builder": "catalog:"
  }
}
